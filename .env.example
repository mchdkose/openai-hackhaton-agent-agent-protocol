# Server-only credentials. Copy this file to .env.local.
OPENROUTER_API_KEY=
FAL_KEY=
EXTRACT_MODEL=anthropic/claude-haiku-5.5
COMPOSE_MODEL=anthropic/claude-sonnet-5.5
REFEREE_MODEL=openai/gpt-6.1-sol
# Fixed, explicitly labelled fictional merchant scenario. Session expiry uses real time.
DEMO_CLOCK_ISO=2026-10-12T17:00:00+03:00
# Set to the public origin after deployment; never include a path.
BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Generate a unique random secret for persistent audit pseudonyms.
SESSION_HMAC_SECRET=
# Optional hosted persistence. Without Redis, a local .data store is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required to enable demo admin controls on a public deployment.
DEMO_ADMIN_TOKEN=
