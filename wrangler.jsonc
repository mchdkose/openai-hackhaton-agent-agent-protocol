{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "askagent-demo",
  "account_id": "e5539802cd5992acd0fe5c053d68ca7d",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "askagent-demo"
    }
  ],
  "d1_databases": [
    {
      "binding": "ASKAGENT_DB",
      "database_name": "askagent-hackathon-demo",
      "database_id": "1b0f3f71-7acf-4acb-a44d-f398a55f04b4",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BASE_URL": "https://askagent-hackathon-demo.pages.dev",
    "NEXT_PUBLIC_SITE_URL": "https://askagent-hackathon-demo.pages.dev",
    "DEMO_CLOCK_ISO": "2026-10-12T17:00:00+03:00",
    "EXTRACT_MODEL": "openai/gpt-6-luna",
    "COMPOSE_MODEL": "openai/gpt-6-luna",
    "REFEREE_MODEL": "openai/gpt-6.1-sol",
    "MODEL_TIMEOUT_MS": "60000",
    "AGENT_MODEL_TIMEOUT_MS": "60000"
  },
  "observability": {
    "enabled": true
  },
  "preview_urls": true,
  "queues": {
    "producers": [
      {
        "binding": "ASKAGENT_JOBS",
        "queue": "askagent-questions"
      }
    ],
    "consumers": [
      {
        "queue": "askagent-questions",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 3
      }
    ]
  }
}
