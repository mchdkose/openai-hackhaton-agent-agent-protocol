{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://askagent-hackathon-demo.pages.dev/askagent-response.schema.json",
  "title": "AskAgent HTTP conversation envelope",
  "description": "Transport and continuation contract. Business-specific requirements, matches and actions are adapter data, not florist concepts in the protocol.",
  "type": "object",
  "required": ["protocol", "version", "kind", "tenant", "answer", "next"],
  "properties": {
    "protocol": {"const": "askagent"},
    "version": {"const": "0.1"},
    "kind": {"enum": ["discovery", "pending", "answer", "transcript", "evidence", "quote", "checkout", "error"]},
    "tenant": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}}},
    "h": {"type": "string", "pattern": "^h_[a-f0-9]{32}$"},
    "status": {"enum": ["yes", "no", "partial", "needs_details"]},
    "answer": {"type": "object", "required": ["title", "bullets", "question"], "properties": {"title": {"type": "string"}, "bullets": {"type": "array", "items": {"type": "string"}}, "question": {"type": ["string", "null"]}}},
    "next": {"type": "array", "items": {"type": "object", "required": ["rel", "label", "url", "method"], "properties": {"rel": {"type": "string"}, "label": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "method": {"const": "GET"}}}},
    "job": {"type": "object", "required": ["id", "status", "expires_at"], "properties": {"id": {"type": "string"}, "status": {"enum": ["queued", "running", "complete", "error"]}, "expires_at": {"type": "string", "format": "date-time"}}},
    "requirements": {"type": "object"},
    "facts": {"type": "array", "items": {"type": "object", "required": ["fact_ref", "value"], "properties": {"fact_ref": {"type": "string"}, "value": {"type": ["string", "number", "boolean"]}}}},
    "error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}
  },
  "allOf": [{"if": {"properties": {"kind": {"const": "pending"}}}, "then": {"required": ["job"], "not": {"anyOf": [{"required": ["status"]}, {"required": ["quote"]}, {"required": ["matches"]}, {"required": ["h"]}]}}}]
}
