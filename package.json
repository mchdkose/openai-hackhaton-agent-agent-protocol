{
  "name": "askagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "build:cloudflare": "node scripts/cloudflare-compat.mjs && opennextjs-cloudflare build && node scripts/cloudflare-sanitize.mjs",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "cf:migrate": "wrangler d1 migrations apply ASKAGENT_DB --remote",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:secrets": "node scripts/cloudflare-secrets.mjs",
    "deploy:pages": "wrangler pages deploy public --cwd pages-proxy --project-name askagent-hackathon-demo --branch main"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@opennextjs/cloudflare": "^1.20.10",
    "@upstash/redis": "^1.35.8",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.4",
    "wrangler": "^4.149.0"
  }
}
